    "paths_not_restored_with_individual_cause": [
      {
        "path": "/etc/shadow",
        "cause": "Content-level change (not permissions). `ssh.emptypasswords`'s local-account half runs `passwd -l <account>` (ActionExec, no checkpoint) against the seeded `contractor` account. Deliberate: hostveil should not restore an empty password. `fileperms.shadow`'s separate permission-only fix (0640) DID roll back exactly in the 2026-09-10 run (verified via `stat`, mode 644 restored) -- same mechanism applies here; not re-verified on this instance since the identical rollback count and not-restored set indicate the same fix set ran the same way.",
        "expected": true
      },
      {
        "path": "/etc/issue",
        "cause": "hostveil's own edit (accounts.local-banner, Auto/checkpointed) rolls back correctly; the hash mismatch is caused by an unrelated apt-driven base-files package upgrade triggered as a side effect of `updates.disabled`'s review fix installing unattended-upgrades -- confirmed via dpkg.log on the 2026-09-10 run (`upgrade base-files:amd64 13ubuntu10.4 13ubuntu10.5`). Same exact path/behavior reproduced here; the causal mechanism does not depend on which VM instance produced it, so it was not re-traced in dpkg.log a second time.",
        "expected": false,
        "note": "Not a hostveil defect; a limitation of hash-diff-only rollback verification when other processes can also write to a watched path during the measurement window."
      },
      {
        "path": "/etc/issue.net",
        "cause": "Same root cause as /etc/issue above (also owned by base-files).",
        "expected": false
      }
    ],
